<Window x:Class="Day4.Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Day4.Lab4.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="מעקב הוצאות" Width="1050" Height="680" MinWidth="900" MinHeight="600"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- טופס הוספה -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid DataContext="{Binding Form}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="תאריך" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                Validation.ErrorTemplate="{StaticResource ErrorBelow}"
                                AutomationProperties.Name="תאריך ההוצאה" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="קטגוריה" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              Validation.ErrorTemplate="{StaticResource ErrorBelow}"
                              AutomationProperties.Name="קטגוריה" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="סכום (₪)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ErrorBelow}"
                             FlowDirection="LeftToRight" VerticalContentAlignment="Center"
                             AutomationProperties.Name="סכום" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="הערה" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ErrorBelow}"
                             MaxLength="120" VerticalContentAlignment="Center"
                             AutomationProperties.Name="הערה" />
                </StackPanel>
                <Button Grid.Column="4" Content="הוסף" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="הוסף הוצאה" />
            </Grid>
        </Border>

        <!-- סינון -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="חודש:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="120" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Margin="0,0,16,0"
                      AutomationProperties.Name="סינון לפי חודש" />
            <TextBlock Text="קטגוריה:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="120" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}"
                      AutomationProperties.Name="סינון לפי קטגוריה" />
        </StackPanel>

        <!-- טבלה + empty state -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
            <DataGrid ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                      AlternatingRowBackground="{StaticResource AltRowBrush}" GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="טבלת הוצאות">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="תאריך" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110" />
                    <DataGridTextColumn Header="קטגוריה" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="סכום" Binding="{Binding Amount, StringFormat='{}{0:N2} ₪'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FlowDirection" Value="LeftToRight" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="הערה" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="אין הוצאות להצגה" FontSize="18" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Expenses.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- סיכום -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="סיכום" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="סה&quot;כ מסונן" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding FilteredTotal, StringFormat='{}{0:N2} ₪'}" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="ממוצע ליום" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding AveragePerDay, StringFormat='{}{0:N2} ₪'}" FontSize="18" />
                <TextBlock Text="לפי קטגוריה" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <ItemsControl ItemsSource="{Binding ByCategory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Percent, StringFormat='{}{0:0.0}%'}"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Amount, StringFormat='{}{0:N2} ₪'}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Category}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- שורת סטטוס -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="שמור" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="שמור לקובץ" />
                <Button Content="מחק" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}"
                        AutomationProperties.Name="מחק הוצאה נבחרת" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="120" Height="6" Margin="12,0" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>

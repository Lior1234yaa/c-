<Window x:Class="Day3.Lab1.Solution.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit Converter" Height="300" Width="460" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterScreen" FontSize="14">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- שורה 0: ערך -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Value:" />
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ValueBox" Margin="0,4" Padding="6,4"
                   TextChanged="ValueBox_TextChanged" KeyDown="ValueBox_KeyDown" />
        <Button    Grid.Row="0" Grid.Column="2" x:Name="SwapButton" Content="⇄" ToolTip="Swap units"
                   Margin="8,4,0,4" Padding="10,2" Click="Swap_Click" />

        <!-- שורה 1-2: יחידות -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="From:" />
        <ComboBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FromUnit" SelectionChanged="Unit_SelectionChanged" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="To:" />
        <ComboBox  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ToUnit" SelectionChanged="Unit_SelectionChanged" />

        <!-- שורה 3: שגיאה -->
        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ErrorText"
                   Foreground="#C00000" FontSize="12" Visibility="Collapsed" />

        <!-- שורה 4: תוצאה -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="ResultText" FontSize="26" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="#512BD4" TextWrapping="Wrap" TextAlignment="Center" />

        <!-- שורה 5: כפתורים -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConvertButton" Content="_Convert" IsDefault="True" Padding="16,6" Margin="0,0,8,0" Click="Convert_Click" />
            <Button Content="C_lear" Padding="16,6" Click="Clear_Click" />
        </StackPanel>
    </Grid>
</Window>

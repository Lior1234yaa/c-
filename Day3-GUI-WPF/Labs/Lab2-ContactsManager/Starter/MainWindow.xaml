<Window x:Class="Day3.Lab2.Starter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Day3.Lab2.Starter.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ContactsViewModel}"
        Title="{Binding Title}" Height="520" Width="860" MinWidth="640" MinHeight="400"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- TODO 8 (בונוס): InputBindings — Ctrl+N Add, Ctrl+S Save, Delete -->

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="➕ Add" Command="{Binding AddCommand}" />
                <Button Content="🗑 Delete" Command="{Binding DeleteCommand}" />
                <Separator />
                <Button Content="💾 Save" Command="{Binding SaveCommand}" />
                <Button Content="⟳ Reload" Command="{Binding LoadCommand}" />
                <Separator />
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Width="180" Margin="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" />
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- TODO 7a: להחליף AutoGenerateColumns בעמודות מפורשות: ★ (CheckBox), Name (FullName), Phone, Email -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding ContactsView}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" />

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- TODO 7b: טופס פרטים קשור ל-Draft: FirstName, LastName, Phone, Email, Notes, IsFavorite
                 עם UpdateSourceTrigger=PropertyChanged, וכפתורי Apply/Cancel שמגיעים לפקודות של החלון
                 דרך RelativeSource AncestorType=Window -->
            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" Padding="12" IsEnabled="{Binding HasSelection}">
                <StackPanel DataContext="{Binding Draft}">
                    <TextBlock Text="{Binding FullName, FallbackValue=No selection}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <Label Content="_First name *" />
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Apply" IsDefault="True"
                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

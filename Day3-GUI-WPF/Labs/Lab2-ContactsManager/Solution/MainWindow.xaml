<Window x:Class="Day3.Lab2.Solution.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Day3.Lab2.Solution.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ContactsViewModel}"
        Title="{Binding Title}" Height="520" Width="860" MinWidth="640" MinHeight="400"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- סרגל כלים -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="➕ Add (Ctrl+N)" Command="{Binding AddCommand}" />
                <Button Content="🗑 Delete" Command="{Binding DeleteCommand}" />
                <Separator />
                <Button Content="💾 Save (Ctrl+S)" Command="{Binding SaveCommand}" />
                <Button Content="⟳ Reload" Command="{Binding LoadCommand}" />
                <Separator />
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Width="180" Margin="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" />
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- רשימה -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding ContactsView}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="★" Binding="{Binding IsFavorite}" Width="36" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- טופס פרטים: קשור ל-Draft -->
            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" Padding="12"
                    IsEnabled="{Binding HasSelection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Draft}">
                        <TextBlock Text="{Binding FullName, FallbackValue=No selection}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

                        <Label Content="_First name *" Target="{Binding ElementName=FirstNameBox}" />
                        <TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="_Last name" Target="{Binding ElementName=LastNameBox}" />
                        <TextBox x:Name="LastNameBox" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="_Phone *" Target="{Binding ElementName=PhoneBox}" />
                        <TextBox x:Name="PhoneBox" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="_Email" Target="{Binding ElementName=EmailBox}" />
                        <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="Notes" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                        <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- חוזרים ל-DataContext של החלון כדי להגיע לפקודות -->
                            <Button Content="Apply" IsDefault="True"
                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Cancel"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>

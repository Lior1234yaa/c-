<Window x:Class="Day3.Lab4.Solution.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Day3.Lab4.Solution.ViewModels"
        xmlns:c="clr-namespace:Day3.Lab4.Solution.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
        Title="Ops Dashboard" Height="600" Width="960" MinWidth="560" MinHeight="420"
        Background="{DynamicResource WindowBackground}">

    <DockPanel Margin="12">
        <!-- כותרת -->
        <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox Content="Live" IsChecked="{Binding IsLive}" VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="{DynamicResource TextPrimary}" />
                <Button Content="🌙 / ☀" Click="ToggleTheme_Click" Style="{StaticResource AccentButton}" />
            </StackPanel>
            <TextBlock Text="Ops Dashboard" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Background="Transparent" BorderThickness="0">
            <!-- ===== Overview ===== -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- UniformGrid: 4 כרטיסים ברוחב שווה; ב-WrapPanel הם היו נשברים -->
                        <UniformGrid Rows="1" Columns="4">
                            <c:StatCard Title="Orders today" Value="{Binding Snapshot.OrdersToday}" Subtitle="since 00:00"
                                        Accent="{DynamicResource Accent}" />
                            <c:StatCard Title="Revenue" Value="{Binding Snapshot.RevenueToday, StringFormat={}{0:C0}}" Subtitle="ILS"
                                        Accent="{DynamicResource Success}" />
                            <c:StatCard Title="Active users" Value="{Binding Snapshot.ActiveUsers}" Subtitle="right now"
                                        Accent="{DynamicResource Warning}" />
                            <c:StatCard Title="Errors" Value="{Binding Snapshot.Errors}" Subtitle="last hour"
                                        Accent="{DynamicResource Danger}" />
                        </UniformGrid>

                        <!-- "גרף" עמודות פשוט: ItemsControl + Rectangle לכל נקודה -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Active users — last 20 samples" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding UsersHistory}" Height="130">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="22" Height="{Binding Height}" Margin="3,0" RadiusX="3" RadiusY="3"
                                                       VerticalAlignment="Bottom" Fill="{DynamicResource Accent}"
                                                       ToolTip="{Binding Value}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Orders ===== -->
            <TabItem Header="Orders">
                <Border Style="{StaticResource Card}">
                    <DataGrid ItemsSource="{Binding RecentOrders}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MinWidth="320">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource H1}" />
                        <CheckBox Content="Dark theme" IsChecked="{Binding IsDark}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding RefreshSeconds, StringFormat=Refresh every {0} s}" Foreground="{DynamicResource TextPrimary}" />
                        <Slider Minimum="1" Maximum="10" Value="{Binding RefreshSeconds}" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Refresh_ValueChanged" Width="260" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

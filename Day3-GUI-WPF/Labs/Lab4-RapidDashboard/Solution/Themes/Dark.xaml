<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#1B1340" />
    <SolidColorBrush x:Key="CardBackground" Color="#27204F" />
    <SolidColorBrush x:Key="CardBorder" Color="#3B3370" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F0FF" />
    <SolidColorBrush x:Key="TextMuted" Color="#A79FD6" />
    <SolidColorBrush x:Key="Accent" Color="#FFB020" />
    <SolidColorBrush x:Key="Success" Color="#5BD48A" />
    <SolidColorBrush x:Key="Danger" Color="#FF7A7A" />
    <SolidColorBrush x:Key="Warning" Color="#FFD166" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ערכת נושא בהירה: רק צבעים. הסגנונות (Styles.xaml) מפנים אליהם ב-DynamicResource -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F4F5F9" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E2E4EC" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1F1B2E" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B6480" />
    <SolidColorBrush x:Key="Accent" Color="#512BD4" />
    <SolidColorBrush x:Key="Success" Color="#2E9E5B" />
    <SolidColorBrush x:Key="Danger" Color="#D64545" />
    <SolidColorBrush x:Key="Warning" Color="#E0A100" />
</ResourceDictionary>

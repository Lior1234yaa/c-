<Window x:Class="Day3.Demo.Events.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Events &amp; Commands" Height="520" Width="760"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- קיצורי מקלדת ברמת החלון: מפעילים Commands -->
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearLogCommand}" />
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== צד שמאל: מקורות אירועים ===== -->
        <!-- ה-Border החיצוני מאזין ל-Click "מבעבע" מהכפתורים בתוכו (routed event bubbling) -->
        <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#512BD4" BorderThickness="1" Padding="8"
                Button.Click="Outer_ButtonClick"
                PreviewMouseDown="Outer_PreviewMouseDown">
            <StackPanel>
                <TextBlock Text="Routed events" FontWeight="Bold" />
                <TextBlock Text="Click a button: Preview (tunneling) is logged first on the Border, then Click bubbles up from the button to the Border."
                           TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnA" Content="Button A" Click="ButtonA_Click" Margin="4" Padding="10,4" />
                    <Button x:Name="BtnB" Content="Button B (Handled=true)" Click="ButtonB_Click" Margin="4" Padding="10,4" />
                </StackPanel>

                <TextBlock Text="TextChanged / KeyDown" FontWeight="Bold" Margin="0,12,0,0" />
                <TextBox x:Name="Input" TextChanged="Input_TextChanged" KeyDown="Input_KeyDown" />

                <TextBlock Text="SelectionChanged" FontWeight="Bold" Margin="0,12,0,0" />
                <ComboBox x:Name="Colors" SelectionChanged="Colors_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Red" />
                    <ComboBoxItem Content="Green" />
                    <ComboBoxItem Content="Blue" />
                </ComboBox>

                <TextBlock Text="ICommand + InputBindings" FontWeight="Bold" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal">
                    <!-- CanExecute מכבה את הכפתור אוטומטית כשאין מה לשמור -->
                    <Button Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" Margin="4" Padding="10,4" />
                    <Button Content="Clear log (Ctrl+L)" Command="{Binding ClearLogCommand}" Margin="4" Padding="10,4" />
                </StackPanel>

                <TextBlock Text="DispatcherTimer" FontWeight="Bold" Margin="0,12,0,0" />
                <TextBlock x:Name="Clock" FontSize="24" FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <!-- ===== צד ימין: יומן אירועים ===== -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Event log" FontWeight="Bold" />
            <ListBox x:Name="Log" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>

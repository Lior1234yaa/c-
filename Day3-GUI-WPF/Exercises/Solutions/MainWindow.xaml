<Window x:Class="Day3.Exercises.Solutions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day 3 — Exercises" Height="520" Width="560" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="תרגילי יום 3 — בחרו תרגיל ולחצו Open (או לחיצה כפולה)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <Button DockPanel.Dock="Bottom" Content="Open" Click="Open_Click" HorizontalAlignment="Right" IsDefault="True" Width="100" />
        <ListBox x:Name="List" MouseDoubleClick="List_MouseDoubleClick" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Stars}" Foreground="#FFB020" />
                        <TextBlock Text="{Binding Number, StringFormat=Ex{0:00}}" FontFamily="Consolas" Width="50" />
                        <TextBlock Text="{Binding Title}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

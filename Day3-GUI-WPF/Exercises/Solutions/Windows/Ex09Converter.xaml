<Window x:Class="Day3.Exercises.Solutions.Windows.Ex09Converter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Day3.Exercises.Solutions.Windows"
        Title="Ex09 — IValueConverter" Height="260" Width="400">
    <Window.Resources>
        <local:TempToBrushConverter x:Key="TempToBrush" />
        <local:ThresholdToVisibilityConverter x:Key="AboveThreshold" />
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="{Binding ElementName=Temp, Path=Value, StringFormat=Temperature: {0:F0}°C}" FontSize="16" />
        <Slider x:Name="Temp" Minimum="-10" Maximum="45" Value="22" />
        <Border Height="60" Margin="0,8" CornerRadius="6"
                Background="{Binding ElementName=Temp, Path=Value, Converter={StaticResource TempToBrush}}" />
        <!-- ConverterParameter: הסף מוגדר ב-XAML -->
        <TextBlock Text="⚠ Heat warning!" Foreground="Red" FontWeight="Bold"
                   Visibility="{Binding ElementName=Temp, Path=Value, Converter={StaticResource AboveThreshold}, ConverterParameter=35}" />
    </StackPanel>
</Window>

<Window x:Class="Day3.Exercises.Solutions.Windows.Ex11Validation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Day3.Exercises.Solutions.Windows"
        Title="Ex11 — ValidationRule" Height="240" Width="400">
    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <Border BorderBrush="Red" BorderThickness="2" CornerRadius="2">
                    <AdornedElementPlaceholder x:Name="Adorner" />
                </Border>
                <TextBlock Foreground="Red" FontSize="11"
                           Text="{Binding ElementName=Adorner, Path=AdornedElement.(Validation.Errors)/ErrorContent}" />
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="Email:" />
        <TextBox x:Name="EmailBox" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Margin="0,2,0,24">
            <TextBox.Text>
                <Binding Path="Email" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:EmailRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <!-- הכפתור מושבת כל עוד יש שגיאה: Trigger על Validation.HasError של ה-TextBox -->
        <Button Content="Subscribe" HorizontalAlignment="Left" Click="Subscribe_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=EmailBox, Path=(Validation.HasError)}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <TextBlock x:Name="Status" Foreground="SeaGreen" Margin="0,8,0,0" />
    </StackPanel>
</Window>

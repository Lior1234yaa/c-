<Window x:Class="Day3.Exercises.Solutions.Windows.Ex03LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ex03 — Login" Height="260" Width="380" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Sign in" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Login" IsDefault="True" Click="Login_Click" />
            <Button Content="_Cancel" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <!-- Label עם Target: Alt+U מעביר פוקוס ל-TextBox -->
            <Label Content="_User name" Target="{Binding ElementName=UserBox}" />
            <TextBox x:Name="UserBox" TabIndex="0" />
            <Label Content="_Password" Target="{Binding ElementName=PassBox}" />
            <PasswordBox x:Name="PassBox" TabIndex="1" />
            <CheckBox Content="Remember me" Margin="0,8,0,0" TabIndex="2" />
            <TextBlock x:Name="Status" Foreground="#C00000" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>

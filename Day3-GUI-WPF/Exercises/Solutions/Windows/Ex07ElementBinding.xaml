<Window x:Class="Day3.Exercises.Solutions.Windows.Ex07ElementBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ex07 — ElementName binding" Height="260" Width="420">
    <!-- כל התרגיל ב-XAML בלבד: אפס קוד -->
    <StackPanel Margin="16">
        <TextBlock Text="{Binding ElementName=Size, Path=Value, StringFormat=Size: {0:F0}px}" />
        <Slider x:Name="Size" Minimum="20" Maximum="200" Value="80" />
        <Rectangle Width="{Binding ElementName=Size, Path=Value}" Height="{Binding ElementName=Size, Path=Value}"
                   Fill="#512BD4" HorizontalAlignment="Left" Margin="0,8" RadiusX="6" RadiusY="6" />
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Text:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="Input" Text="Hello binding" />
        </DockPanel>
        <TextBlock Text="{Binding ElementName=Input, Path=Text, StringFormat=Preview: {0}}" FontSize="16" Margin="0,6,0,0" />
        <TextBlock Text="{Binding ElementName=Input, Path=Text.Length, StringFormat={}{0} characters}" Foreground="Gray" />
    </StackPanel>
</Window>

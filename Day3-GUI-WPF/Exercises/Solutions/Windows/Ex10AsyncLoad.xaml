<Window x:Class="Day3.Exercises.Solutions.Windows.Ex10AsyncLoad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ex10 — Async load" Height="300" Width="420">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button x:Name="LoadButton" Content="Load" Click="Load_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="8,0" Foreground="Gray" />
        </StackPanel>
        <ProgressBar DockPanel.Dock="Top" x:Name="Progress" Height="14" Margin="4" Minimum="0" Maximum="100" />
        <ListBox x:Name="Results" Margin="4" />
    </DockPanel>
</Window>

<Window x:Class="Day3.Exercises.Solutions.Windows.Ex08ShoppingList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ex08 — Shopping list" Height="380" Width="420">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" IsDefault="True" />
            <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" />
            <TextBlock Text="{Binding Total, StringFormat=Total: {0:C}}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="4" />
        </DockPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" Margin="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Price, StringFormat={}{0:C}}" Foreground="Gray" />
                        <CheckBox IsChecked="{Binding IsBought}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Margin="6,0" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
